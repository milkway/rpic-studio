# Template do nginx do container web. __BASE__ é substituído no build pelo
# BASE_PATH (ex.: "/" ou "/rpic/"). Mesma imagem serve na raiz ou sob subpath.
server {
  listen 80;
  server_name _;
  absolute_redirect off;

  # API → serviço Rust/Axum (fase 2; inofensivo sem o serviço).
  location __BASE__api/ {
    proxy_pass http://api:8080/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # SPA — assets + fallback de rota do React Router sob o base path.
  location __BASE__ {
    alias /usr/share/nginx/html/;
    try_files $uri __BASE__index.html;
  }
}
