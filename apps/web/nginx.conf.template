# Template do nginx do container web. __BASE__ é substituído no build pelo
# BASE_PATH (ex.: "/" ou "/rpic/"). Mesma imagem serve na raiz ou sob subpath.
server {
  listen 80;
  server_name _;
  absolute_redirect off;

  # nginx's mime.types has no `.mjs`: MapLibre's worker (`maplibre-gl-worker-*.mjs`)
  # came out as application/octet-stream and the browser refused to start it
  # ("Worker failed to load"), so the Map pane drew nothing in production.
  # `types` in a server block replaces the inherited table, hence the include.
  include /etc/nginx/mime.types;
  types { application/javascript mjs; }

  # API → serviço Rust/Axum. Upstream em variável + resolver do Docker para o
  # nginx subir mesmo sem o serviço "api" (app funciona 100% anônimo sem ele).
  location __BASE__api/ {
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $api_upstream api;
    rewrite ^__BASE__api/(.*)$ /api/$1 break;
    proxy_pass http://$api_upstream:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # SPA — assets + fallback de rota do React Router sob o base path.
  location __BASE__ {
    alias /usr/share/nginx/html/;
    try_files $uri __BASE__index.html;
  }
}
