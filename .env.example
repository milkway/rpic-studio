# rpic-app — variáveis de ambiente (copie para .env e preencha)

# --- API (Rust/Axum) ---
DATABASE_URL=postgres://rpic:rpic@localhost:5435/rpic
API_PORT=8080

# URL pública do app (usada em redirects do OAuth). Em dev, o proxy do Vite
# mantém o cookie first-party: http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
# redirect_uri autorizado: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookies com Secure (true em produção atrás de HTTPS)
COOKIE_SECURE=false

# --- Postgres (docker compose) ---
POSTGRES_USER=rpic
POSTGRES_PASSWORD=rpic
POSTGRES_DB=rpic
